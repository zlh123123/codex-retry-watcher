<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.codex-retry-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/CodexRetryWatcher.app/Contents/MacOS/CodexRetryWatcher</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- The app appends to ~/.local/share/codex-retry-watcher/watcher.log itself.
       This only catches crashes before that logging starts. -->
  <key>StandardErrorPath</key><string>/tmp/codex-retry-watcher.stderr.log</string>
</dict>
</plist>
